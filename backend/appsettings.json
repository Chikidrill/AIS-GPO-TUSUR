{
  "Jwt": {
    "Issuer": "AisGpo",
    "Audience": "AisGpo.Client",
    "Secret": "",
    "ExpiresMinutes": 120
  },
  "DevSeed": {
    "Enabled": false
  },
  "FileStorage": {
    "RootPath": ".local-storage/work-files"
  },
  "WorkUpload": {
    "MaxFiles": 5,
    "MaxFileSizeBytes": 20971520,
    "MaxTotalSizeBytes": 52428800,
    "MaxRequestBodySizeBytes": 62914560,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}