{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ais_gpo;Username=ais_gpo;Password=ais_gpo"
  },
  "Jwt": {
    "Issuer": "AisGpo",
    "Audience": "AisGpo.Client",
    "Secret": "dev-secret-change-me-at-least-32-bytes",
    "ExpiresMinutes": 120
  },
  "DevSeed": {
    "Enabled": true
  },
  "FileStorage": {
    "RootPath": ".local-storage/work-files"
  },
  "WorkUpload": {
    "MaxFiles": 5,
    "MaxFileSizeBytes": 20971520,
    "MaxTotalSizeBytes": 52428800,
    "MaxRequestBodySizeBytes": 62914560,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx",
      ".txt",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}